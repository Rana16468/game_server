// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Testing purpose 
model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

model User {
  id           String         @id @default(uuid())
  username     String
  email        String         @unique
  password     String
  ipaddress    String
  phonenumber  String
  role         UserRole       @default(USER)
  photo        String?
  isVerified   Boolean        @default(false)
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Monitoring   Monitoring[]
  FoodCategory FoodCategory[]
  Rating       Rating[]
  View         View[]
  BlockMyPlate BlockMyPlate? // One-to-one relationship

  @@map("users")
}

model Monitoring {
  id         String   @id @default(uuid())
  country    String
  ipaddress  String
  visitcount Int      @default(0)
  os         String
  browser    String
  device     String
  userId     String?
  city       String   @default("Unknown") // ✅ Provide a default value
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("monitorings")
}

model FoodCategory {
  id            String            @id @default(uuid())
  userId        String
  categorieName String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id])
  posts         PostRateMyPlate[]

  @@unique([userId, categorieName]) // Add this line to make the combination unique
  @@map("foodcategorys")
}

model PostRateMyPlate {
  id                    String        @id @default(uuid())
  foodname              String
  categorieId           String
  restaurantShopName    String?
  restaurantShopAddress String?
  mapLocation           String?
  poststatus            PostStatus    @default(PRIVATE)
  price                 Float         @default(0)
  opinion               String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  foodCategory          FoodCategory  @relation(fields: [categorieId], references: [id])
  photos                Photo[]
  ratings               Rating[]
  View                  View[]
  BlockMyPlate          BlockMyPlate[]//  one many relationship

  @@map("postratemyplates")
}

model Photo {
  id        Int             @id @default(autoincrement())
  postId    String
  photo     String
  post      PostRateMyPlate @relation(fields: [postId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("photos")
}

model Rating {
  id        String          @id @default(uuid())
  rating    Int             @default(0)
  isRating  Boolean         @default(false)
  userId    String
  postId    String
  user      User            @relation(fields: [userId], references: [id])
  post      PostRateMyPlate @relation(fields: [postId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) // ✅ Ensure default value

  @@unique([userId, postId])
  @@map("ratings")
}

model View {
  id        String          @id @default(uuid())
  view      Int             @default(0)
  userId    String
  postId    String
  user      User            @relation(fields: [userId], references: [id])
  post      PostRateMyPlate @relation(fields: [postId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) // ✅ Ensure default value

  @@unique([userId, postId])
  @@map("views")
}

model BlockMyPlate {
  id           String          @id @default(uuid())
  isBlock      Boolean         @default(false)
  valid_reason String
  userId       String          @unique
  postId       String          @unique
  user         User            @relation(fields: [userId], references: [id]) // Foreign key reference
  post         PostRateMyPlate @relation(fields: [postId], references: [id]) // Foreign key reference
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now())
  @@map("blockmyplates")
}

enum UserStatus {
  ACTIVE
  BLOCK
  DELETED
}

enum UserRole {
  USER
  EMPLOYEE
  ADMIN
}

enum PostStatus {
  PUBLIC
  PRIVATE
}
